{
    "name": "T Development Container",
    "build": {
        "dockerfile": "../Dockerfile"
    },
    // "image": "tttttttttttttttttttt/t:latest",

    "workspaceFolder": "/workspace",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    },

    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace,type=bind",
        "source=${localWorkspaceFolder}/../open_spiel,target=/open_spiel,type=bind",
        "source=claude-code-config,target=/root/.claude,type=volume",
        "source=open-spiel-ccache,target=/ccache,type=volume",
        "source=open-spiel-download-cache,target=/download_cache,type=volume"
    ],

    // Build the C++ deps and the venv (including the open-spiel wheel, built
    // from the /open_spiel mount above) once the mounts are live. Not part of
    // the Dockerfile itself: at image-build time /open_spiel doesn't exist yet.
    "postCreateCommand": "cd /open_spiel && ./install.sh && cd /workspace && uv sync",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/venv/bin/python"
            }
        }
    },

    "forwardPorts": [
        8888
    ]
}